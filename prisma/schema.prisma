generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["ribbit"]
}

model Class_file {
  file_id      Int          @id(map: "class_file_pkey") @default(autoincrement())
  display_name String       @db.VarChar(255)
  storage_path String
  file_url     String?
  file_type    String?      @db.VarChar(50)
  metadata     Json?
  class_id     Int
  Course_class Course_class @relation(fields: [class_id], references: [class_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_file_class")

  @@schema("ribbit")
}

model Course {
  id_course   Int          @id(map: "course_pkey") @default(autoincrement())
  title       String       @db.VarChar(150)
  description String
  banner_url  String?
  slug        String       @unique(map: "course_slug_key") @db.VarChar(255)
  fk_teacher  String       @db.Uuid
  User        User         @relation(fields: [fk_teacher], references: [user_uuid], onDelete: NoAction, onUpdate: NoAction, map: "fk_course_teacher")
  Enrollment  Enrollment[]
  Module      Module[]

  @@schema("ribbit")
}

model Course_class {
  class_id         Int                @id(map: "class_pkey") @default(autoincrement())
  title            String             @db.VarChar(150)
  description      String
  index_order      Int
  fk_module        Int
  Class_file       Class_file[]
  Module           Module             @relation(fields: [fk_module], references: [id_module], onDelete: Cascade, onUpdate: NoAction, map: "fk_class_module")
  Student_progress Student_progress[]

  @@unique([fk_module, index_order], map: "class_fk_module_index_order_key")
  @@schema("ribbit")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Enrollment {
  id_enrollment Int       @id(map: "enrollments_pkey") @default(autoincrement())
  progress      Int?      @default(0)
  enrolled_at   DateTime? @default(now()) @db.Timestamp(6)
  student_id    String    @db.Uuid
  course_id     Int
  Course        Course    @relation(fields: [course_id], references: [id_course], onDelete: Cascade, onUpdate: NoAction, map: "fk_enrollment_course")
  User          User      @relation(fields: [student_id], references: [user_uuid], onDelete: Cascade, onUpdate: NoAction, map: "fk_enrollment_student")

  @@unique([student_id, course_id], map: "enrollments_student_id_course_id_key")
  @@schema("ribbit")
}

model Module {
  id_module    Int            @id(map: "module_pkey") @default(autoincrement())
  title        String         @db.VarChar(150)
  description  String
  index_order  Int
  fk_course    Int
  Course_class Course_class[]
  Course       Course         @relation(fields: [fk_course], references: [id_course], onDelete: Cascade, onUpdate: NoAction, map: "fk_module_course")

  @@unique([fk_course, index_order], map: "module_fk_course_index_order_key")
  @@schema("ribbit")
}

model Student_progress {
  progress_id  Int          @id(map: "student_progress_pkey") @default(autoincrement())
  completed_at DateTime?    @default(now()) @db.Timestamp(6)
  class_id     Int
  student_id   String       @db.Uuid
  Course_class Course_class @relation(fields: [class_id], references: [class_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_progress_class")
  User         User         @relation(fields: [student_id], references: [user_uuid], onDelete: Cascade, onUpdate: NoAction, map: "fk_progress_student")

  @@unique([student_id, class_id], map: "student_progress_student_id_class_id_key")
  @@schema("ribbit")
}

model User {
  user_uuid        String             @id(map: "users_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String             @unique(map: "users_email_key") @db.VarChar(255)
  role             user_role_enum
  password_hash    String             @db.VarChar(255)
  full_name        String             @db.VarChar(255)
  avatar_url       String?
  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  Course           Course[]
  Enrollment       Enrollment[]
  Student_progress Student_progress[]

  @@schema("ribbit")
}

enum user_role_enum {
  admin
  prof
  aluno

  @@schema("ribbit")
}
